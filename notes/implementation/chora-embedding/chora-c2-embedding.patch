+    /// Refresh route identity after every constellation operation, including BFCache traversal.
+    fn sync_chora_message_routes(&mut self) {
+        let active: HashMap<_, _> = self
+            .webviews
+            .keys()
+            .filter_map(|webview_id| {
+                let context = self
+                    .browsing_contexts
+                    .get(&BrowsingContextId::from(*webview_id))?;
+                let pipeline = self.pipelines.get(&context.pipeline_id)?;
+                (context.pipelines.contains(&context.pipeline_id)
+                    && self.get_activity(context.pipeline_id) == DocumentActivity::FullyActive)
+                    .then_some((*webview_id, (context.pipeline_id, pipeline.url.clone())))
+            })
+            .collect();
+        // Exact URL changes also invalidate same-document push/replace/fragment
+        // navigation, even when the pipeline is reused.
+        self.chora_routes
+            .retain(|webview_id, (pipeline_id, _, url)| {
+                active
+                    .get(webview_id)
+                    .is_some_and(|(active_pipeline, active_url)| {
+                        active_pipeline == pipeline_id && active_url == url
+                    })
+            });
+        for (webview_id, (pipeline_id, url)) in active {
+            self.chora_routes
+                .entry(webview_id)
+                .or_insert_with(|| (pipeline_id, ChoraNavigationEpoch::new(), url));
+        }
+        let routes = &self.chora_routes;
+        let pending = self.pending_chora_messages.cancel_where(|route| {
+            !routes
+                .get(&route.webview_id())
+                .is_some_and(|(pipeline, epoch, _)| {
+                    *pipeline == route.pipeline_id() && *epoch == route.navigation_epoch()
+                })
+        });
+        self.reject_chora_messages(pending, ChoraMessageError::Cancelled);
+    }
+
+    fn reject_chora_messages(
+        &self,
+        pending: Vec<
+            PendingRequest<
+                ChoraMessageId,
+                ChoraCallerContext,
+                servo_base::generic_channel::GenericCallback<ChoraMessageResponse>,
+            >,
+        >,
+        reason: ChoraMessageError,
+    ) {
+        for entry in pending {
+            let _ = entry.responder.send(Err(reason));
+            self.embedder_proxy.send(EmbedderMsg::ChoraMessageCancelled(
+                entry.route.webview_id(),
+                entry.id,
+                reason,
+            ));
+        }
+    }
+
+    fn expire_chora_messages(&mut self) {
+        let pending = self
+            .pending_chora_messages
+            .expire(std::time::Instant::now());
+        self.reject_chora_messages(pending, ChoraMessageError::TimedOut);
+    }
+
+    fn handle_chora_message(
+        &mut self,
+        webview_id: WebViewId,
+        pipeline_id: PipelineId,
+        document_origin: servo_url::ImmutableOrigin,
+        channel: String,
+        payload: String,
+        responder: servo_base::generic_channel::GenericCallback<ChoraMessageResponse>,
+    ) {
+        if let Err(error) = embedder_traits::validate_chora_message(&channel, &payload) {
+            let _ = responder.send(Err(error));
+            return;
+        }
+        self.sync_chora_message_routes();
+        let context = (|| {
+            if self.shutting_down {
+                return None;
+            }
+            let pipeline = self.pipelines.get(&pipeline_id)?;
+            let browsing_context = self
+                .browsing_contexts
+                .get(&BrowsingContextId::from(webview_id))?;
+            if pipeline.webview_id != webview_id
+                || pipeline.browsing_context_id != BrowsingContextId::from(webview_id)
+                || browsing_context.parent_pipeline_id.is_some()
+                || browsing_context.pipeline_id != pipeline_id
+                || !browsing_context.pipelines.contains(&pipeline_id)
+                || self.get_activity(pipeline_id) != DocumentActivity::FullyActive
+            {
+                return None;
+            }
+            // Use the engine's final URL, not a caller-supplied origin string.
+            // Compare to the actual document security origin as well: inherited,
+            // opaque and sandboxed-origin documents cannot masquerade as URL origins.
+            let origin =
+                embedder_traits::validate_chora_document_origin(&document_origin, &pipeline.url)
+                    .ok()?;
+            let (active_pipeline, epoch, _) = self.chora_routes.get(&webview_id)?;
+            if *active_pipeline != pipeline_id {
+                return None;
+            }
+            Some(ChoraCallerContext::from_engine_route(
+                self.chora_engine_instance,
+                webview_id,
+                pipeline_id,
+                *epoch,
+                origin,
+                browsing_context.is_private,
+            ))
+        })();
+        let Some(context) = context else {
+            let _ = responder.send(Err(ChoraMessageError::InvalidContext));
+            return;
+        };
+        let id = ChoraMessageId::new();
+        if let Err(responder) = self.pending_chora_messages.insert(
+            id,
+            context.clone(),
+            responder,
+            std::time::Instant::now(),
+        ) {
+            let _ = responder.send(Err(ChoraMessageError::Busy));
+            return;
+        }
+        self.embedder_proxy
+            .send(EmbedderMsg::ChoraMessage(context, id, channel, payload));
+    }
+
+    fn handle_chora_message_reply(&mut self, id: ChoraMessageId, reply: ChoraMessageResponse) {
+        self.sync_chora_message_routes();
+        self.expire_chora_messages();
+        // A consumed, cancelled, expired or cross-instance request has no reply owner.
+        if let Some(pending) = self.pending_chora_messages.take(id) {
+            let _ = pending
+                .responder
+                .send(embedder_traits::bound_chora_reply(reply));
         }
     }
 
