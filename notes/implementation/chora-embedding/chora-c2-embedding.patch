+<!doctype html>
+<!-- This Source Code Form is subject to the terms of the Mozilla Public
+     License, v. 2.0. If a copy of the MPL was not distributed with this
+     file, You can obtain one at https://mozilla.org/MPL/2.0/. -->
+<meta charset="utf-8">
+<title>Chora generic messaging fails closed without a host handler</title>
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+promise_test(async t => {
+  assert_true("chora" in navigator);
+  await promise_rejects_exactly(t, "host denied the message",
+      navigator.chora.request("test.echo", '{"origin":"https://spoof.invalid"}'));
+}, "An unhandled page request is denied; identity text in the body grants nothing");
+
+promise_test(async t => {
+  await promise_rejects_exactly(t, "host message exceeds its size limit",
+      navigator.chora.request("test.echo", "x".repeat(16385)));
+}, "Oversized messages are rejected before dispatch");
+
+promise_test(async t => {
+  const frame = document.createElement("iframe");
+  const loaded = new Promise(resolve => frame.onload = resolve);
+  frame.srcdoc = "<!doctype html><title>child</title>";
+  document.body.append(frame);
+  t.add_cleanup(() => frame.remove());
+  await loaded;
+  await promise_rejects_exactly(t, "document is not eligible for host messaging",
+      frame.contentWindow.navigator.chora.request("test.echo", "child"));
+}, "A same-origin subframe cannot use the initial top-level-only profile");
+</script>
