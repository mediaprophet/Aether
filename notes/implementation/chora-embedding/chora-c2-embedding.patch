+use std::cell::Cell;
+
+use dom_struct::dom_struct;
+use embedder_traits::{
+    CHORA_MESSAGE_MAX_PENDING, ChoraMessageError, ChoraMessageResponse, validate_chora_message,
+};
+use js::context::JSContext;
+use js::realm::CurrentRealm;
+use script_bindings::reflector::{Reflector, reflect_dom_object};
+use servo_base::generic_channel::GenericCallback;
+use servo_constellation_traits::ScriptToConstellationMessage;
+use servo_url::origin::DomainComparable;
+
+use crate::dom::bindings::codegen::Bindings::ChoraMessagingBinding::ChoraMessagingMethods;
+use crate::dom::bindings::codegen::Bindings::WindowBinding::Window_Binding::WindowMethods;
+use crate::dom::bindings::refcounted::{Trusted, TrustedPromise};
+use crate::dom::bindings::reflector::DomGlobal;
+use crate::dom::bindings::root::DomRoot;
+use crate::dom::bindings::str::DOMString;
+use crate::dom::globalscope::GlobalScope;
+use crate::dom::promise::{Promise, RootedPromise};
+use crate::routed_promise::RoutedPromiseListener;
+
+#[dom_struct]
+pub(crate) struct ChoraMessaging {
+    reflector_: Reflector,
+    pending: Cell<usize>,
+}
+
+impl ChoraMessaging {
+    pub(crate) fn new(cx: &mut JSContext, global: &GlobalScope) -> DomRoot<Self> {
+        reflect_dom_object(
+            cx,
+            Box::new(Self {
+                reflector_: Reflector::new(),
+                pending: Cell::new(0),
+            }),
+            global,
+        )
+    }
+}
+
+impl ChoraMessagingMethods<crate::DomTypeHolder> for ChoraMessaging {
+    fn Request(
+        &self,
+        cx: &mut CurrentRealm,
+        channel: DOMString,
+        payload: DOMString,
+    ) -> RootedPromise {
+        let promise = Promise::new_in_realm(cx);
+        let global = self.global();
+        let window = global.as_window();
+        let document = window.Document();
+        let channel = channel.to_string();
+        let payload = payload.to_string();
+        let origin = global.origin().immutable().clone();
+        let error = validate_chora_message(&channel, &payload)
+            .err()
+            .or_else(|| {
+                if !window.is_top_level()
+                    || !document.is_fully_active()
+                    || !document
+                        .creation_sandboxing_flag_set_considering_parent_iframe()
+                        .is_empty()
+                    || !matches!(global.get_url().scheme(), "https" | "http")
+                    || !matches!(origin.scheme(), Some("https" | "http"))
+                {
+                    Some(ChoraMessageError::InvalidContext)
+                } else if self.pending.get() >= CHORA_MESSAGE_MAX_PENDING {
+                    Some(ChoraMessageError::Busy)
+                } else {
+                    None
+                }
+            });
+        if let Some(error) = error {
+            promise.reject_native(cx, &error.to_string());
+            return promise;
+        }
+        self.pending.set(self.pending.get() + 1);
+        let source = global
+            .task_manager()
+            .dom_manipulation_task_source()
+            .to_sendable();
+        let mut trusted_promise = Some(TrustedPromise::from(&promise));
+        let trusted_receiver = Trusted::new(self);
+        let callback =
+            match GenericCallback::new(move |message: Result<ChoraMessageResponse, _>| {
+                let Some(trusted) = trusted_promise.take() else {
+                    return;
+                };
+                let receiver = trusted_receiver.clone();
+                // Channel teardown rejects instead of panicking in a routed task.
+                let response = message.unwrap_or(Err(ChoraMessageError::Unavailable));
+                source.queue(task!(chora_message_reply: move |cx| {
+                    let promise = trusted.root(cx);
+                    receiver.root().handle_response(cx, response, &promise);
+                }));
+            }) {
+                Ok(callback) => callback,
+                Err(_) => {
+                    self.pending.set(self.pending.get().saturating_sub(1));
+                    promise.reject_native(cx, &ChoraMessageError::Unavailable.to_string());
+                    return promise;
+                },
+            };
+        let response_on_failure = callback.clone();
+        if global
+            .script_to_constellation_chan()
+            .send(ScriptToConstellationMessage::ChoraMessage(
+                origin, channel, payload, callback,
+            ))
+            .is_err()
+        {
+            let _ = response_on_failure.send(Err(ChoraMessageError::Unavailable));
+        }
+        promise
+    }
+}
+
+impl RoutedPromiseListener<crate::DomTypeHolder, ChoraMessageResponse> for ChoraMessaging {
+    fn handle_response(
+        &self,
+        cx: &mut JSContext,
+        response: ChoraMessageResponse,
+        promise: &RootedPromise,
+    ) {
+        self.pending.set(self.pending.get().saturating_sub(1));
+        match response {
+            Ok(body) => promise.resolve_native(cx, &body),
+            Err(error) => promise.reject_native(cx, &error.to_string()),
+        }
+    }
+}
