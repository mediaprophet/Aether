+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Bounded engine-owned request storage, independent of IPC and DOM runtimes.
+
+use std::collections::HashMap;
+use std::hash::Hash;
+use std::time::{Duration, Instant};
+
+pub struct PendingRequest<I, R, S> {
+    pub id: I,
+    pub route: R,
+    pub responder: S,
+    deadline: Instant,
+}
+
+pub struct PendingRequests<I, R, S> {
+    entries: HashMap<I, PendingRequest<I, R, S>>,
+    capacity: usize,
+    timeout: Duration,
+}
+
+impl<I: Copy + Eq + Hash, R, S> PendingRequests<I, R, S> {
+    pub fn new(capacity: usize, timeout: Duration) -> Self {
+        Self {
+            entries: HashMap::new(),
+            capacity,
+            timeout,
+        }
+    }
+    /// Failure returns the responder to the caller so it can reject explicitly.
+    pub fn insert(&mut self, id: I, route: R, responder: S, now: Instant) -> Result<(), S> {
+        if self.entries.len() >= self.capacity || self.entries.contains_key(&id) {
+            return Err(responder);
+        }
+        self.entries.insert(
+            id,
+            PendingRequest {
+                id,
+                route,
+                responder,
+                deadline: now + self.timeout,
+            },
+        );
+        Ok(())
+    }
+    pub fn take(&mut self, id: I) -> Option<PendingRequest<I, R, S>> {
+        self.entries.remove(&id)
+    }
+    /// The constellation uses this as a select timeout, so an idle page also expires.
+    pub fn wait_duration(&self, now: Instant) -> Option<Duration> {
+        self.entries
+            .values()
+            .map(|entry| entry.deadline.saturating_duration_since(now))
+            .min()
+    }
+    pub fn expire(&mut self, now: Instant) -> Vec<PendingRequest<I, R, S>> {
+        let ids: Vec<_> = self
+            .entries
+            .iter()
+            .filter_map(|(id, entry)| (entry.deadline <= now).then_some(*id))
+            .collect();
+        ids.into_iter()
+            .filter_map(|id| self.entries.remove(&id))
+            .collect()
+    }
+    pub fn cancel_where(
+        &mut self,
+        mut cancelled: impl FnMut(&R) -> bool,
+    ) -> Vec<PendingRequest<I, R, S>> {
+        let ids: Vec<_> = self
+            .entries
+            .iter()
+            .filter_map(|(id, entry)| cancelled(&entry.route).then_some(*id))
+            .collect();
+        ids.into_iter()
+            .filter_map(|id| self.entries.remove(&id))
+            .collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn response_is_consumed_once_and_capacity_recovers() {
+        let now = Instant::now();
+        let mut pending = PendingRequests::new(1, Duration::from_secs(30));
+        pending.insert(1, "route", "first", now).unwrap();
+        assert_eq!(pending.insert(2, "route", "busy", now), Err("busy"));
+        assert_eq!(pending.take(1).unwrap().responder, "first");
+        assert!(pending.take(1).is_none());
+        pending.insert(2, "route", "second", now).unwrap();
+    }
+
+    #[test]
+    fn idle_deadline_is_observable_and_expires_without_another_request() {
+        let now = Instant::now();
+        let mut pending = PendingRequests::new(2, Duration::from_secs(30));
+        pending.insert(1, "route", "reply", now).unwrap();
+        assert_eq!(pending.wait_duration(now), Some(Duration::from_secs(30)));
+        assert!(pending.expire(now + Duration::from_secs(29)).is_empty());
+        assert_eq!(
+            pending
+                .expire(now + Duration::from_secs(30))
+                .pop()
+                .unwrap()
+                .responder,
+            "reply"
+        );
+        assert!(pending.take(1).is_none());
+        assert_eq!(pending.wait_duration(now), None);
+    }
+
+    #[test]
+    fn navigation_and_profile_change_invalidate_only_the_affected_route() {
+        let now = Instant::now();
+        let mut pending = PendingRequests::new(4, Duration::from_secs(30));
+        pending.insert(1, (10, 1), "old epoch", now).unwrap();
+        pending.insert(2, (10, 2), "current epoch", now).unwrap();
+        pending.insert(3, (20, 1), "other engine", now).unwrap();
+        assert_eq!(
+            pending
+                .cancel_where(|route| *route == (10, 1))
+                .pop()
+                .unwrap()
+                .responder,
+            "old epoch"
+        );
+        assert!(pending.take(1).is_none());
+        assert_eq!(pending.take(2).unwrap().responder, "current epoch");
+        assert_eq!(pending.take(3).unwrap().responder, "other engine");
+    }
+
+    #[test]
+    fn duplicate_ids_cannot_replace_the_original_reply_owner() {
+        let now = Instant::now();
+        let mut pending = PendingRequests::new(4, Duration::from_secs(30));
+        pending.insert(1, "route", "original", now).unwrap();
+        assert_eq!(
+            pending.insert(1, "other route", "replacement", now),
+            Err("replacement")
+        );
+        assert_eq!(pending.take(1).unwrap().responder, "original");
+    }
+
+    #[test]
+    fn shutdown_drains_all_reply_owners() {
+        let now = Instant::now();
+        let mut pending = PendingRequests::new(4, Duration::from_secs(30));
+        pending.insert(1, "a", (), now).unwrap();
+        pending.insert(2, "b", (), now).unwrap();
+        assert_eq!(pending.cancel_where(|_| true).len(), 2);
+        assert_eq!(pending.wait_duration(now), None);
+    }
+}
