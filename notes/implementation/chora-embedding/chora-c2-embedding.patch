+
+//! Generic page-to-host messages. Data in a message never grants host authority.
+
+use std::fmt;
+
+use serde::{Deserialize, Serialize};
+use servo_base::id::{PipelineId, WebViewId};
+use servo_url::{ImmutableOrigin, ServoUrl};
+use uuid::Uuid;
+
+pub const CHORA_MESSAGE_MAX_CHANNEL_BYTES: usize = 128;
+pub const CHORA_MESSAGE_MAX_PAYLOAD_BYTES: usize = 16 * 1024;
+pub const CHORA_MESSAGE_MAX_REPLY_BYTES: usize = 64 * 1024;
+pub const CHORA_MESSAGE_MAX_PENDING: usize = 64;
+pub const CHORA_MESSAGE_TIMEOUT_SECS: u64 = 30;
+
+macro_rules! opaque_id {
+    ($name:ident) => {
+        #[derive(Clone, Copy, Debug, Deserialize, Eq, Hash, PartialEq, Serialize)]
+        pub struct $name(Uuid);
+        impl $name {
+            #[doc(hidden)]
+            pub fn new() -> Self {
+                Self(Uuid::new_v4())
+            }
+            pub fn as_bytes(&self) -> &[u8; 16] {
+                self.0.as_bytes()
+            }
+        }
+    };
+}
+opaque_id!(ChoraEngineInstanceId);
+opaque_id!(ChoraNavigationEpoch);
+opaque_id!(ChoraMessageId);
+
+/// The route established by the engine, separate from the page-controlled body.
+///
+/// The host associates `engine_instance` and private-browsing state with its own
+/// profile. These identifiers do not themselves authorize any host operation.
+/// The initial producer supports active top-level HTTP(S) documents only;
+/// subframes, workers, inherited and opaque origins are denied before dispatch.
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+pub struct ChoraCallerContext {
+    engine_instance: ChoraEngineInstanceId,
+    webview_id: WebViewId,
+    pipeline_id: PipelineId,
+    navigation_epoch: ChoraNavigationEpoch,
+    origin: ImmutableOrigin,
+    private_browsing: bool,
+}
+
+impl ChoraCallerContext {
+    #[doc(hidden)]
+    pub fn from_engine_route(
+        engine_instance: ChoraEngineInstanceId,
+        webview_id: WebViewId,
+        pipeline_id: PipelineId,
+        navigation_epoch: ChoraNavigationEpoch,
+        origin: ImmutableOrigin,
+        private_browsing: bool,
+    ) -> Self {
+        Self {
+            engine_instance,
+            webview_id,
+            pipeline_id,
+            navigation_epoch,
+            origin,
+            private_browsing,
+        }
+    }
+    pub fn engine_instance(&self) -> ChoraEngineInstanceId {
+        self.engine_instance
+    }
+    pub fn webview_id(&self) -> WebViewId {
+        self.webview_id
+    }
+    /// The active top-level document/frame identity.
+    pub fn pipeline_id(&self) -> PipelineId {
+        self.pipeline_id
+    }
+    pub fn navigation_epoch(&self) -> ChoraNavigationEpoch {
+        self.navigation_epoch
+    }
+    pub fn origin(&self) -> &ImmutableOrigin {
+        &self.origin
+    }
+    pub fn is_private_browsing(&self) -> bool {
+        self.private_browsing
+    }
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+pub enum ChoraMessageError {
+    Denied,
+    Cancelled,
+    TimedOut,
+    Unavailable,
+    TooLarge,
+    InvalidContext,
+    Busy,
+}
+
+impl fmt::Display for ChoraMessageError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(match self {
+            Self::Denied => "host denied the message",
+            Self::Cancelled => "message route was cancelled",
+            Self::TimedOut => "host message timed out",
+            Self::Unavailable => "host messaging is unavailable",
+            Self::TooLarge => "host message exceeds its size limit",
+            Self::InvalidContext => "document is not eligible for host messaging",
+            Self::Busy => "too many pending host messages",
+        })
+    }
+}
+impl std::error::Error for ChoraMessageError {}
+
+pub type ChoraMessageResponse = Result<String, ChoraMessageError>;
+
+pub fn validate_chora_message(channel: &str, payload: &str) -> Result<(), ChoraMessageError> {
+    if channel.len() > CHORA_MESSAGE_MAX_CHANNEL_BYTES
+        || payload.len() > CHORA_MESSAGE_MAX_PAYLOAD_BYTES
+    {
+        return Err(ChoraMessageError::TooLarge);
+    }
+    if channel.is_empty()
+        || !channel
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'_' | b'-'))
+    {
+        return Err(ChoraMessageError::Denied);
+    }
+    Ok(())
+}
+
+pub fn bound_chora_reply(reply: ChoraMessageResponse) -> ChoraMessageResponse {
+    match reply {
+        Ok(body) if body.len() > CHORA_MESSAGE_MAX_REPLY_BYTES => Err(ChoraMessageError::TooLarge),
+        other => other,
+    }
+}
+
+/// Validate the document security origin against the engine's final pipeline URL.
+/// Callers must obtain both values from engine state, never from the message body.
+#[doc(hidden)]
+pub fn validate_chora_document_origin(
+    document_origin: &ImmutableOrigin,
+    pipeline_url: &ServoUrl,
+) -> Result<ImmutableOrigin, ChoraMessageError> {
+    let origin = pipeline_url.origin();
+    if !matches!(pipeline_url.scheme(), "https" | "http")
+        || !matches!(origin.scheme(), Some("https" | "http"))
+        || &origin != document_origin
+    {
+        return Err(ChoraMessageError::InvalidContext);
+    }
+    Ok(origin)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn origin_validation_uses_exact_scheme_host_port_and_rejects_opaque_contexts() {
+        let pipeline = ServoUrl::parse("https://example.test/page").unwrap();
+        assert_eq!(
+            validate_chora_document_origin(&pipeline.origin(), &pipeline),
+            Ok(pipeline.origin())
+        );
+        let other = ServoUrl::parse("https://other.test/page").unwrap();
+        assert_eq!(
+            validate_chora_document_origin(&other.origin(), &pipeline),
+            Err(ChoraMessageError::InvalidContext)
+        );
+        let different_port = ServoUrl::parse("https://example.test:8443/").unwrap();
+        assert_eq!(
+            validate_chora_document_origin(&different_port.origin(), &pipeline),
+            Err(ChoraMessageError::InvalidContext)
+        );
+        let first = ImmutableOrigin::new_opaque();
+        let second = ImmutableOrigin::new_opaque();
+        assert_ne!(first, second);
+        assert_eq!(
+            validate_chora_document_origin(&first, &pipeline),
+            Err(ChoraMessageError::InvalidContext)
+        );
+        let blob =
+            ServoUrl::parse("blob:https://example.test/00000000-0000-0000-0000-000000000001")
+                .unwrap();
+        assert_eq!(
+            validate_chora_document_origin(&pipeline.origin(), &blob),
+            Err(ChoraMessageError::InvalidContext)
+        );
+        let data = ServoUrl::parse("data:text/html,hello").unwrap();
+        assert_eq!(
+            validate_chora_document_origin(&pipeline.origin(), &data),
+            Err(ChoraMessageError::InvalidContext)
+        );
+        let blank = ServoUrl::parse("about:blank").unwrap();
+        assert_eq!(
+            validate_chora_document_origin(&pipeline.origin(), &blank),
+            Err(ChoraMessageError::InvalidContext)
+        );
+    }
+
+    #[test]
+    fn message_and_reply_limits_are_enforced_in_bytes() {
+        assert_eq!(
+            validate_chora_message("app.read", &"x".repeat(CHORA_MESSAGE_MAX_PAYLOAD_BYTES)),
+            Ok(())
+        );
+        assert_eq!(
+            validate_chora_message("app.read", &"x".repeat(CHORA_MESSAGE_MAX_PAYLOAD_BYTES + 1)),
+            Err(ChoraMessageError::TooLarge)
+        );
+        assert_eq!(
+            validate_chora_message(
+                "identity
+spoof",
+                "body"
+            ),
+            Err(ChoraMessageError::Denied)
+        );
+        assert_eq!(
+            bound_chora_reply(Ok("x".repeat(CHORA_MESSAGE_MAX_REPLY_BYTES + 1))),
+            Err(ChoraMessageError::TooLarge)
+        );
+        assert_eq!(
+            bound_chora_reply(Err(ChoraMessageError::Denied)),
+            Err(ChoraMessageError::Denied)
+        );
+    }
+}
