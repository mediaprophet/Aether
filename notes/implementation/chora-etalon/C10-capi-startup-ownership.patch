--- /dev/null
+++ b/ffi/capi/owned_handle.rs
@@ -0,0 +1,48 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+/// Consume an owned C handle and reclaim its allocation before startup begins.
+///
+/// # Safety
+/// `handle` must come from `Box::into_raw` and must not have been consumed before.
+pub(crate) unsafe fn take<T>(handle: *mut T) -> T {
+    // SAFETY: The caller transfers its unique ownership of the allocation.
+    unsafe { *Box::from_raw(handle) }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::cell::Cell;
+    use std::rc::Rc;
+
+    struct Payload(Rc<Cell<usize>>);
+
+    impl Drop for Payload {
+        fn drop(&mut self) {
+            self.0.set(self.0.get() + 1);
+        }
+    }
+
+    #[test]
+    fn consume_handle_transfers_payload_exactly_once() {
+        let drops = Rc::new(Cell::new(0));
+        let handle = Box::into_raw(Box::new(Payload(drops.clone())));
+        let payload = unsafe { super::take(handle) };
+        assert_eq!(drops.get(), 0);
+        drop(payload);
+        assert_eq!(drops.get(), 1);
+    }
+
+    #[test]
+    fn startup_failure_still_drops_consumed_payload() {
+        let drops = Rc::new(Cell::new(0));
+        let handle = Box::into_raw(Box::new(Payload(drops.clone())));
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _payload = unsafe { super::take(handle) };
+            panic!("simulated Rust startup failure");
+        }));
+        assert!(result.is_err());
+        assert_eq!(drops.get(), 1);
+    }
+}
