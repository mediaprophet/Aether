+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Content registration barrier for device-loss notification delivery.
+
+#[derive(Debug, Eq, Hash, PartialEq)]
+pub(crate) struct DeviceReady<T> {
+    ready: bool,
+    retired: bool,
+    lost: bool,
+    pending: Option<T>,
+}
+
+impl<T> Default for DeviceReady<T> {
+    fn default() -> Self {
+        Self {
+            ready: false,
+            retired: false,
+            lost: false,
+            pending: None,
+        }
+    }
+}
+
+impl<T> DeviceReady<T> {
+    pub(crate) fn record_loss(&mut self, event: T) -> Option<T> {
+        if self.retired || self.lost {
+            return None;
+        }
+        self.lost = true;
+        if self.ready {
+            Some(event)
+        } else {
+            self.pending = Some(event);
+            None
+        }
+    }
+    pub(crate) fn registered(&mut self) -> Option<T> {
+        if self.retired {
+            return None;
+        }
+        self.ready = true;
+        self.pending.take()
+    }
+    pub(crate) fn retire(&mut self) {
+        self.retired = true;
+        self.pending = None;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::DeviceReady;
+    #[test]
+    fn loss_waits_for_registration_and_is_delivered_once() {
+        let mut gate = DeviceReady::default();
+        assert_eq!(gate.record_loss("unknown"), None);
+        assert_eq!(gate.registered(), Some("unknown"));
+        assert_eq!(gate.registered(), None);
+        assert_eq!(gate.record_loss("destroyed"), None);
+    }
+    #[test]
+    fn live_registration_and_retirement_bound_callbacks() {
+        let mut gate = DeviceReady::default();
+        assert_eq!(gate.registered(), None);
+        assert_eq!(gate.record_loss("unknown"), Some("unknown"));
+        gate.retire();
+        assert_eq!(gate.record_loss("destroyed"), None);
+    }
+    #[test]
+    fn retirement_cancels_early_loss() {
+        let mut gate = DeviceReady::default();
+        gate.record_loss("unknown");
+        gate.retire();
+        assert_eq!(gate.registered(), None);
+    }
+}
