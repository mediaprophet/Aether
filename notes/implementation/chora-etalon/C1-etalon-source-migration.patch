+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+import unittest
+from check_gpu_sources import ETALON_REV, ETALON_URL, HYPERMEDIA_REV, HYPERMEDIA_URL, REQUIRED, violations
+
+
+def source(revision=ETALON_REV):
+    return f"git+{ETALON_URL}?rev={revision}#{revision}"
+
+
+def packages():
+    return [{"name": name, "version": "0.0.2", "source": f"git+{HYPERMEDIA_URL}?rev={HYPERMEDIA_REV}#{HYPERMEDIA_REV}" if name.startswith("vector-") else source()} for name in sorted(REQUIRED)]
+
+
+class SourceIdentityTests(unittest.TestCase):
+    def test_reviewed_family(self):
+        self.assertEqual(violations(packages()), [])
+
+    def test_alias_cannot_hide_registry_core(self):
+        graph = packages()
+        graph[0]["source"] = "registry+https://github.com/rust-lang/crates.io-index"
+        self.assertTrue(violations(graph))
+
+    def test_wrong_revision_is_rejected(self):
+        graph = packages()
+        graph[0]["source"] = source("6ace6cc6413a87ca10a1da58397ddc7c0b2fc41e")
+        self.assertTrue(violations(graph))
+
+    def test_optional_legacy_renderer_is_rejected(self):
+        graph = packages() + [{"name": "vello", "version": "0.11.0", "source": "registry+https://github.com/rust-lang/crates.io-index"}]
+        self.assertTrue(violations(graph))
+
+    def test_only_reviewed_public_shim_is_accepted(self):
+        shim = {"name": "wgpu", "version": "0.0.2", "source": source()}
+        self.assertEqual(violations(packages() + [shim]), [])
+        shim["source"] = "registry+https://github.com/rust-lang/crates.io-index"
+        self.assertTrue(violations(packages() + [shim]))
+
+
+if __name__ == "__main__":
+    unittest.main()
