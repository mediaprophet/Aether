+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Callbacks signal completion from any thread; only the owner executes GPU work.
+
+use std::cell::{Cell, RefCell};
+use std::collections::BTreeMap;
+use std::sync::mpsc::{self, Receiver, Sender};
+
+type Callback<T, R> = Box<dyn FnOnce(&T, R)>;
+
+pub(crate) struct OwnerQueue<T, R> {
+    next_id: Cell<u64>,
+    pending: RefCell<BTreeMap<u64, Callback<T, R>>>,
+    sender: Sender<(u64, R)>,
+    receiver: Receiver<(u64, R)>,
+}
+
+impl<T: 'static, R: Send + 'static> OwnerQueue<T, R> {
+    pub(crate) fn new() -> Self {
+        let (sender, receiver) = mpsc::channel();
+        Self {
+            next_id: Cell::new(0),
+            pending: RefCell::new(BTreeMap::new()),
+            sender,
+            receiver,
+        }
+    }
+
+    pub(crate) fn register(
+        &self,
+        callback: impl FnOnce(&T, R) + 'static,
+    ) -> Box<dyn FnOnce(R) + Send> {
+        let id = self.next_id.get();
+        self.next_id
+            .set(id.checked_add(1).expect("GPU completion ID exhausted"));
+        self.pending.borrow_mut().insert(id, Box::new(callback));
+        let sender = self.sender.clone();
+        Box::new(move |result| {
+            // A closed receiver means owner teardown already cancelled this work.
+            let _ = sender.send((id, result));
+        })
+    }
+
+    pub(crate) fn register_signal(
+        &self,
+        result: R,
+        callback: impl FnOnce(&T) + 'static,
+    ) -> Box<dyn FnOnce() + Send> {
+        let signal = self.register(move |owner, _| callback(owner));
+        Box::new(move || signal(result))
+    }
+
+    pub(crate) fn cancel_all(&self, owner: &T, mut result: impl FnMut() -> R) {
+        let callbacks = std::mem::take(&mut *self.pending.borrow_mut());
+        for (_, callback) in callbacks {
+            callback(owner, result());
+        }
+    }
+
+    pub(crate) fn drain(&self, owner: &T) {
+        while let Ok((id, result)) = self.receiver.try_recv() {
+            // Release the registry borrow before invoking a callback. Callbacks
+            // may enqueue more work, but never reenter a borrowed GPU hub.
+            let callback = self.pending.borrow_mut().remove(&id);
+            if let Some(callback) = callback {
+                callback(owner, result);
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::OwnerQueue;
+    use std::cell::Cell;
+    use std::rc::Rc;
+
+    #[test]
+    fn worker_signal_runs_callback_on_owner_thread() {
+        let queue = OwnerQueue::<Rc<Cell<u32>>, u32>::new();
+        let value = Rc::new(Cell::new(0));
+        let owner_thread = std::thread::current().id();
+        let local_capture = value.clone();
+        let signal = queue.register(move |owner, result| {
+            assert_eq!(std::thread::current().id(), owner_thread);
+            assert!(Rc::ptr_eq(owner, &local_capture));
+            owner.set(result);
+        });
+        std::thread::spawn(move || signal(42)).join().unwrap();
+        assert_eq!(value.get(), 0);
+        queue.drain(&value);
+        assert_eq!(value.get(), 42);
+        queue.drain(&value);
+        assert_eq!(value.get(), 42);
+    }
+
+    #[test]
+    fn teardown_cancels_local_callback_and_late_signal_is_harmless() {
+        let capture = Rc::new(());
+        let queue = OwnerQueue::<(), ()>::new();
+        let local_capture = capture.clone();
+        let signal = queue.register(move |_, ()| drop(local_capture));
+        assert_eq!(Rc::strong_count(&capture), 2);
+        drop(queue);
+        assert_eq!(Rc::strong_count(&capture), 1);
+        std::thread::spawn(move || signal(())).join().unwrap();
+    }
+    #[test]
+    fn cancellation_completes_pending_once_and_ignores_late_signal() {
+        let queue = OwnerQueue::<Cell<u32>, Result<u32, ()>>::new();
+        let owner = Cell::new(0);
+        let signal = queue.register(|owner, result| {
+            assert!(result.is_err());
+            owner.set(owner.get() + 1);
+        });
+        queue.cancel_all(&owner, || Err(()));
+        signal(Ok(1));
+        queue.drain(&owner);
+        assert_eq!(owner.get(), 1);
+    }
+    #[test]
+    fn cancellation_preserves_registration_order() {
+        let queue = OwnerQueue::<std::cell::RefCell<Vec<u32>>, ()>::new();
+        let owner = std::cell::RefCell::new(vec![]);
+        let _map = queue.register(|owner, ()| owner.borrow_mut().push(1));
+        let _done = queue.register_signal((), |owner| owner.borrow_mut().push(2));
+        queue.cancel_all(&owner, || ());
+        assert_eq!(*owner.borrow(), vec![1, 2]);
+    }
+}
