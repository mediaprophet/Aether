+use etalon_core::resource::{BufferAccessResult, BufferMapOperation};
+use etalon_core_remote::global::Global;
+use etalon_core_remote_types::{BufferDescriptor, id::BufferId};
+
+#[path = "../../../../components/webgpu/owner_queue.rs"]
+mod owner_queue;
+
+/// Type-check the actual remoting map contract without requiring a GPU adapter.
+pub fn owner_map_contract(global: &Global, buffer: BufferId) {
+    let completions = owner_queue::OwnerQueue::<Global, BufferAccessResult>::new();
+    let callback = completions.register(move |global, result| {
+        if result.is_ok() {
+            if let Ok(mapping) = global.buffer_get_mapped_range(buffer, 0, None) {
+                let _owned_bytes = mapping.read_slice().to_vec();
+                drop(mapping);
+            }
+            global.buffer_unmap(buffer);
+        }
+    });
+    let operation = BufferMapOperation {
+        mode: etalon_types::MapMode::Read,
+        callback: Some(callback),
+    };
+    global.buffer_map_async(buffer, 0, None, operation);
+    let _ = global.poll_all_devices(false);
+    completions.drain(global);
+}
+
+pub fn descriptor_contract(descriptor: &BufferDescriptor<'_>) -> u64 {
+    descriptor.size
+}
+
+// Compile the actual Chora encoder adapters with the canonical Etalon protocol,
+// independently of browser workspace dependencies such as Stylo/SpiderMonkey.
+extern crate self as webgpu_traits;
+pub use etalon_core_remote_types::encoders::{TexelCopyBufferInfo, TexelCopyTextureInfo};
+pub use etalon_core_remote_types::id;
+pub use etalon_types::{BufferSize, Color, Extent3d, IndexFormat};
+#[path = "../../../../components/shared/webgpu/encoders.rs"]
+mod commands;
+pub use commands::*;
+#[path = "../../../../components/webgpu/encoders.rs"]
+mod chora_encoders;
+
+extern crate etalon_types as wgpu_types;
+
+pub fn request_device_contract(
+    global: &Global,
+    adapter: id::AdapterId,
+    device: id::DeviceId,
+    queue: id::QueueId,
+    descriptor: &etalon_types::DeviceDescriptor<Option<String>>,
+) {
+    let remote = etalon_core_remote_types::DeviceDescriptor {
+        label: descriptor.label.as_deref().map(std::borrow::Cow::Borrowed),
+        required_features: descriptor.required_features.features_webgpu,
+        required_limits: descriptor.required_limits.clone(),
+        default_queue: Default::default(),
+    };
+    let _native_request = !descriptor.required_features.features_etalon.is_empty();
+    let result = global.adapter_request_device(
+        adapter,
+        &remote,
+        etalon_types::Trace::Off,
+        etalon_types::Features::empty(),
+        device,
+        queue,
+    );
+    if result.is_ok() {
+        global.device_on_uncaptured_error(
+            device,
+            std::sync::Arc::new(|_: etalon_types::error::Error| {}),
+        );
+        global.device_push_error_scope(device, etalon_types::error::ErrorFilter::Validation);
+        let _ = global.device_pop_error_scope(device);
+        global.device_set_device_lost_closure(device, Box::new(|_, _| {}));
+    }
+}
+
+pub fn instance_descriptor_contract() -> etalon_types::InstanceDescriptor {
+    use etalon_types::InstanceDescriptor;
+    let backends = etalon_types::Backends::PRIMARY;
+    InstanceDescriptor {
+        backends,
+        backend_options: wgpu_types::BackendOptions {
+            gl: wgpu_types::GlBackendOptions {
+                gles_minor_version: wgpu_types::Gles3MinorVersion::Automatic,
+                fence_behavior: wgpu_types::GlFenceBehavior::Normal,
+                debug_fns: wgpu_types::GlDebugFns::Auto,
+            },
+            dx12: wgpu_types::Dx12BackendOptions {
+                ..Default::default()
+            },
+            noop: wgpu_types::NoopBackendOptions::default(),
+        },
+
+        flags: wgpu_types::InstanceFlags::from_build_config()
+            | wgpu_types::InstanceFlags::AUTOMATIC_TIMESTAMP_NORMALIZATION
+            | wgpu_types::InstanceFlags::STRICT_WEBGPU_COMPLIANCE,
+        // TODO(sagudev): firefox actually sets this, but it can cause OOM for us
+        // meaning that we are likely leaking something
+        memory_budget_thresholds: wgpu_types::MemoryBudgetThresholds {
+            for_resource_creation: Some(95),
+            for_device_loss: Some(99),
+        },
+        display: None,
+    }
+}
+
+#[cfg(feature = "canvas")]
+pub async fn canvas_renderer_contract() {
+    use std::num::NonZeroUsize;
+    use vello::wgpu::{Instance, InstanceDescriptor};
+    let instance = Instance::new(InstanceDescriptor::default());
+    let mut context = vello::util::RenderContext {
+        instance,
+        devices: Vec::new(),
+    };
+    let device_id = context.device(None).await.unwrap();
+    let device = &context.devices[device_id].device;
+    let _renderer = vello::Renderer::new(
+        device,
+        vello::RendererOptions {
+            use_cpu: false,
+            num_init_threads: NonZeroUsize::new(1),
+            antialiasing_support: vello::AaSupport::area_only(),
+            pipeline_cache: None,
+        },
+    )
+    .unwrap();
+}
+
+extern crate etalon_core as wgpu_core;
+#[path = "../../../../components/shared/webgpu/types.rs"]
+mod chora_ipc_types;
+
+#[path = "../../../../components/shared/webgpu/error.rs"]
+mod chora_errors;
+
+pub fn mapped_write_contract(global: &Global, buffer: BufferId, bytes: &[u8]) {
+    if let Ok(mapping) = global.buffer_get_mapped_range(buffer, 0, Some(bytes.len() as u64)) {
+        // SAFETY: The live mapping guard pins this write-only range until the
+        // copy completes. It is dropped before buffer_unmap below.
+        let mut target = unsafe {
+            etalon_types::WriteOnly::new(std::ptr::NonNull::slice_from_raw_parts(
+                mapping.ptr(),
+                mapping.len() as usize,
+            ))
+        };
+        target.copy_from_slice(bytes);
+    }
+    global.buffer_unmap(buffer);
+}
+
+pub fn manual_error_contract(global: &Global, device: id::DeviceId) {
+    global.device_handle_error(
+        device,
+        chora_errors::Error::Validation("invalid DOM descriptor".into()),
+        None,
+        "Chora WebGPU validation",
+    );
+}
