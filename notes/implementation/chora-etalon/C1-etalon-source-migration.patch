+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+"""Reject unreviewed GPU source identities in a Cargo-generated lockfile.
+
+This is a conservative inventory gate, not a substitute for target/feature
+resolution or GPU/CTS tests. Run after Cargo regenerates the lockfile.
+"""
+
+import argparse
+from pathlib import Path
+import sys
+import tomllib
+
+ETALON_REV = "8e8ab6c8349bcc6ab1d81138f2c9f2a0c90f0952"
+HYPERMEDIA_REV = "af57e82120b30b47fca238edb21a839d2cdb4278"
+ETALON_URL = "https://github.com/mediaprophet/etalon.git"
+HYPERMEDIA_URL = "https://github.com/mediaprophet/hypermedia-production.git"
+REQUIRED = {"etalon", "etalon-core", "etalon-core-remote", "etalon-core-remote-types", "etalon-types", "etalon-hal", "naga", "naga-types", "vector-compute-renderer", "vector-compute-shaders"}
+
+
+def pinned_source(source, url, revision):
+    # Both the Git URL and resolved commit matter. An alias or package name
+    # supplies no evidence that Cargo selected the reviewed implementation.
+    return (
+        source.startswith(f"git+{url}?")
+        and source.endswith(f"#{revision}")
+        and f"rev={revision}" in source.split("#", 1)[0].split("?", 1)[1].split("&")
+    )
+
+
+def violations(packages):
+    errors = []
+    found = set()
+    for package in packages:
+        name = package["name"]
+        source = package.get("source", "")
+        if name in REQUIRED:
+            found.add(name)
+        if name.startswith("wgpu"):
+            if name == "wgpu" and pinned_source(source, ETALON_URL, ETALON_REV):
+                continue
+            errors.append(f"legacy GPU package {name} {package['version']}: {source or 'path source'}")
+        elif name.startswith("etalon") or name in {"naga", "naga-types"}:
+            if not pinned_source(source, ETALON_URL, ETALON_REV):
+                errors.append(f"unreviewed Etalon/shader source {name}: {source or 'path source'}")
+        elif name in {"vello", "vello_shaders"}:
+            errors.append(f"legacy GPU renderer {name}: {source or 'path source'}")
+        elif name in {"vector-compute-renderer", "vector-compute-shaders", "gpu-command-profiler"}:
+            if not pinned_source(source, HYPERMEDIA_URL, HYPERMEDIA_REV):
+                errors.append(f"unreviewed renderer source {name}: {source or 'path source'}")
+    errors.extend(f"missing mandatory package {name}" for name in sorted(REQUIRED - found))
+    return errors
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("lockfile", type=Path, nargs="?", default=Path(__file__).resolve().parents[2] / "Cargo.lock")
+    args = parser.parse_args()
+    with args.lockfile.open("rb") as handle:
+        errors = violations(tomllib.load(handle)["package"])
+    if errors:
+        print("GPU dependency inventory FAILED:", file=sys.stderr)
+        print("\n".join(f"- {error}" for error in errors), file=sys.stderr)
+        return 1
+    print("GPU source inventory passed; runtime and feature/target qualification remain required.")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
