+pub fn identity_release_contract() {
+    let identities = chora_identities::IdentityHub::default();
+    let device = identities.create_device_id();
+    let queue = identities.create_queue_id();
+    identities.free_device_id(device);
+    identities.free_queue_id(queue);
+    assert_ne!(identities.create_device_id(), device);
+    assert_ne!(identities.create_queue_id(), queue);
+}
