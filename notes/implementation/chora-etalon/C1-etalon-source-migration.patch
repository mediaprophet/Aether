+etalon-core = { version = "=0.0.2", git = "https://github.com/mediaprophet/etalon.git", rev = "8e8ab6c8349bcc6ab1d81138f2c9f2a0c90f0952", features = ["wgsl", "serde", "noop"] }
+etalon-core-remote = { version = "=0.0.2", git = "https://github.com/mediaprophet/etalon.git", rev = "8e8ab6c8349bcc6ab1d81138f2c9f2a0c90f0952" }
+etalon-core-remote-types = { version = "=0.0.2", git = "https://github.com/mediaprophet/etalon.git", rev = "8e8ab6c8349bcc6ab1d81138f2c9f2a0c90f0952" }
