+//! Materialize invalid resources when content-side descriptor conversion failed.
+
+use etalon_core_remote::global::Global;
+use etalon_core_remote_types::{TextureViewDescriptor, id};
+
+pub(crate) fn invalid_texture_view(
+    global: &Global,
+    device: id::DeviceId,
+    texture: id::TextureId,
+    view: id::TextureViewId,
+) {
+    // The remoting API has no create_texture_view_error entry point and the
+    // core invalid constructor is private. A zero mip count is unconditionally
+    // invalid; canonical validation registers a real invalid TextureView Arc.
+    // Content already generated the descriptor error, so consume only this
+    // adapter's duplicate validation with a nested scope.
+    global.device_push_error_scope(device, wgpu_types::error::ErrorFilter::Validation);
+    global.texture_create_view(
+        texture,
+        &TextureViewDescriptor {
+            range: wgpu_types::ImageSubresourceRange {
+                mip_level_count: Some(0),
+                ..Default::default()
+            },
+            ..Default::default()
+        },
+        view,
+    );
+    let _ = global.device_pop_error_scope(device);
+}
