+//! Genuine, already-closed Etalon resources for unfulfillable WebGPU requests.
+//!
+//! This private instance is never involved in browser adapter selection. A
+//! device is destroyed before its reserved IDs are published in the main hub.
+//! Canonical Etalon invalid-resource propagation then handles resource creation,
+//! cross-device validation, mapping and teardown without absent or invented IDs.
+
+use etalon_core_remote::global::Global;
+use etalon_core_remote_types::id::{DeviceId, QueueId};
+use std::sync::Arc;
+use wgpu_core::instance::{Adapter, Instance};
+
+pub(crate) struct ClosedDeviceFactory {
+    instance: Arc<Instance>,
+    adapter: Arc<Adapter>,
+}
+
+impl ClosedDeviceFactory {
+    pub(crate) fn new() -> Result<Self, String> {
+        let instance = Instance::new(
+            "Chora private closed resources",
+            wgpu_types::InstanceDescriptor {
+                backends: wgpu_types::Backends::NOOP,
+                backend_options: wgpu_types::BackendOptions {
+                    noop: wgpu_types::NoopBackendOptions {
+                        enable: true,
+                        features: Some(wgpu_types::Features::empty()),
+                        limits: Some(wgpu_types::Limits::downlevel_defaults()),
+                        ..Default::default()
+                    },
+                    ..Default::default()
+                },
+                flags: wgpu_types::InstanceFlags::empty(),
+                memory_budget_thresholds: Default::default(),
+                display: None,
+            },
+            None,
+        );
+        let adapter = instance
+            .request_adapter(
+                &wgpu_types::RequestAdapterOptions::default(),
+                wgpu_types::Backends::NOOP,
+            )
+            .map_err(|error| error.to_string())?;
+        Ok(Self { instance, adapter })
+    }
+
+    pub(crate) fn import_closed(
+        &self,
+        global: &Global,
+        device_id: DeviceId,
+        queue_id: QueueId,
+    ) -> Result<(), String> {
+        // The application's descriptor has already been checked against its
+        // real adapter. It must never be reinterpreted as Noop capabilities.
+        let (device, queue) = self
+            .adapter
+            .request_device(&wgpu_types::DeviceDescriptor {
+                label: Some("Chora closed WebGPU device".into()),
+                required_limits: wgpu_types::Limits::downlevel_defaults(),
+                ..Default::default()
+            })
+            .map_err(|error| error.to_string())?;
+        device.destroy();
+        assert!(
+            !device.is_valid(),
+            "A closed device must never be published as live"
+        );
+        global.import_device(device, device_id);
+        global.import_queue(queue, queue_id);
+        Ok(())
+    }
+
+    pub(crate) fn poll(&self) -> Result<bool, wgpu_core::device::WaitIdleError> {
+        self.instance.poll_all_devices(false)
+    }
+}
