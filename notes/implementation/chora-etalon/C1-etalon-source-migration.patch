+//! Preserve WebGPU async pipeline completion after device loss.
+
+use etalon_core_remote::global::Global;
+use etalon_core_remote_types::{PipelineError, id, pipelines};
+
+pub(crate) fn compute(
+    global: &Global,
+    device: id::DeviceId,
+    descriptor: &pipelines::ComputePipelineDescriptor<'_>,
+    pipeline: id::ComputePipelineId,
+) -> Result<(), PipelineError> {
+    let result = global.device_create_compute_pipeline_or_error(device, descriptor, pipeline);
+    if result.is_err() && !global.resolve_device_id(device).is_valid() {
+        global.device_create_compute_pipeline(device, descriptor, pipeline);
+        Ok(())
+    } else {
+        result
+    }
+}
+
+pub(crate) fn render(
+    global: &Global,
+    device: id::DeviceId,
+    descriptor: &pipelines::RenderPipelineDescriptor<'_>,
+    pipeline: id::RenderPipelineId,
+) -> Result<(), PipelineError> {
+    let result = global.device_create_render_pipeline_or_error(device, descriptor, pipeline);
+    if result.is_err() && !global.resolve_device_id(device).is_valid() {
+        global.device_create_render_pipeline(device, descriptor, pipeline);
+        Ok(())
+    } else {
+        result
+    }
+}
