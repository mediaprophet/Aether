+# See Cargo.toml.orig for the original contents.
+
+[package]
+publish = false
+edition = "2024"
+rust-version = "1.89"
+name = "vector-compute-renderer"
+version = "0.11.0"
+build = false
+autolib = false
+autobins = false
+autoexamples = false
+autotests = false
+autobenches = false
+description = "A GPU compute-centric 2D renderer."
+readme = "README.md"
+keywords = [
+    "2d",
+    "vector-graphics",
+]
+categories = [
+    "rendering",
+    "graphics",
+]
+license = "Apache-2.0 OR MIT"
+repository = "https://github.com/linebender/vello"
+resolver = "2"
+
+[package.metadata.docs.rs]
+all-features = true
+default-target = "x86_64-unknown-linux-gnu"
+targets = []
+
+[features]
+# Compatibility for immutable external consumers; owned code uses Etalon.
+wgpu = ["etalon"]
+wgpu_default = ["etalon-default"]
+wgpu-profiler = ["etalon-profiler"]
+bump_estimate = ["vello_encoding/bump_estimate"]
+debug_layers = []
+default = [
+    "etalon",
+    "etalon-default",
+]
+hot_reload = ["vello_shaders/compile"]
+etalon = [
+    "dep:etalon",
+    "dep:vello_shaders",
+    "dep:futures-intrusive",
+]
+etalon-profiler = ["dep:etalon-profiler"]
+etalon-default = [
+    "etalon",
+    "etalon/default",
+]
+
+[lib]
+name = "vello"
+path = "src/lib.rs"
+
+[dependencies.bytemuck]
+version = "1.25.0"
+features = ["derive"]
+
+[dependencies.futures-intrusive]
+version = "0.5.0"
+optional = true
+
+[dependencies.log]
+version = "0.4.29"
+
+[dependencies.peniko]
+version = "0.6.1"
+default-features = true
+
+[dependencies.png]
+version = "0.18.1"
+
+[dependencies.skrifa]
+version = "0.44.0"
+features = [
+    "autohint_shaping",
+    "std",
+]
+default-features = false
+
+[dependencies.static_assertions]
+version = "1.1.0"
+
+[dependencies.thiserror]
+version = "2.0.18"
+default-features = false
+
+[dependencies.vello_encoding]
+version = "0.11.0"
+
+[dependencies.vello_shaders]
+package = "vector-compute-shaders"
+version = "=0.11.0"
+path = "../vector-compute-shaders"
+optional = true
+
+[dependencies.etalon]
+package = "etalon"
+version = "=0.0.2"
+git = "https://github.com/mediaprophet/etalon.git"
+rev = "8e8ab6c8349bcc6ab1d81138f2c9f2a0c90f0952"
+features = [
+    "std",
+    "wgsl",
+]
+optional = true
+default-features = false
+
+[dependencies.etalon-profiler]
+package = "gpu-command-profiler"
+version = "=0.28.0"
+path = "../gpu-command-profiler"
+optional = true
+
+[lints.clippy]
+allow_attributes_without_reason = "warn"
+cargo_common_metadata = "warn"
+cast_possible_truncation = "warn"
+collection_is_never_read = "warn"
+dbg_macro = "warn"
+debug_assert_with_mut_call = "warn"
+default_trait_access = "warn"
+doc_markdown = "warn"
+fn_to_numeric_cast_any = "warn"
+infinite_loop = "warn"
+large_stack_arrays = "warn"
+mismatching_type_param_order = "warn"
+missing_assert_message = "warn"
+missing_fields_in_debug = "warn"
+negative_feature_names = "warn"
+redundant_feature_names = "warn"
+same_functions_in_if_condition = "warn"
+semicolon_if_nothing_returned = "warn"
+should_panic_without_expect = "warn"
+todo = "warn"
+too_many_arguments = "allow"
+unseparated_literal_suffix = "warn"
+use_self = "warn"
+wildcard_dependencies = "warn"
+
+[lints.rust]
+elided_lifetimes_in_paths = "warn"
+keyword_idents_2024 = "forbid"
+missing_debug_implementations = "warn"
+missing_docs = "warn"
+non_ascii_idents = "forbid"
+non_local_definitions = "forbid"
+trivial_numeric_casts = "warn"
+unnameable_types = "warn"
+unreachable_pub = "warn"
+unsafe_op_in_unsafe_fn = "forbid"
+unused_import_braces = "warn"
+unused_lifetimes = "warn"
+unused_macro_rules = "warn"
+unused_qualifications = "warn"
+
+[lints.rust.unexpected_cfgs]
+level = "warn"
+priority = 0
+check-cfg = [
+    "cfg(disable_dispatch_sse4_2)",
+    "cfg(disable_dispatch_avx2)",
+    "cfg(disable_dispatch_avx512)",
+]
