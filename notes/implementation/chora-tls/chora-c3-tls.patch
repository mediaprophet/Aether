+#[derive(Debug)]
+struct HostVerifier {
+    calls: Arc<AtomicUsize>,
+    deny: bool,
+}
+impl EmbedderCertVerifier for HostVerifier {
+    fn verify_server_cert(
+        &self,
+        _leaf: &[u8],
+        _intermediates: &[&[u8]],
+        name: &str,
+        _ocsp: &[u8],
+        standard: Result<(), String>,
+    ) -> EmbedderCertDecision {
+        assert_eq!(name, "localhost");
+        assert!(standard.is_ok());
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        if self.deny {
+            EmbedderCertDecision::Deny("test host denial".into())
+        } else {
+            EmbedderCertDecision::DeferToStandard
+        }
+    }
+}
