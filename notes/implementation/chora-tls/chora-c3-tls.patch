+fn credentials(expired: bool) -> (Certificate, Certificate, KeyPair) {
+    let mut params = CertificateParams::new(Vec::<String>::new()).unwrap();
+    params.is_ca = IsCa::Ca(BasicConstraints::Unconstrained);
+    params
+        .distinguished_name
+        .push(rcgen::DnType::CommonName, "Chora TLS test root");
+    let ca_key = KeyPair::generate().unwrap();
+    let ca = params.self_signed(&ca_key).unwrap();
+    let mut params = CertificateParams::new(vec!["localhost".into()]).unwrap();
+    params
+        .distinguished_name
+        .push(rcgen::DnType::CommonName, "localhost");
+    params.extended_key_usages = vec![
+        ExtendedKeyUsagePurpose::ServerAuth,
+        ExtendedKeyUsagePurpose::ClientAuth,
+    ];
+    if expired {
+        params.not_before = rcgen::date_time_ymd(2000, 1, 1);
+        params.not_after = rcgen::date_time_ymd(2001, 1, 1);
+    }
+    let key = KeyPair::generate().unwrap();
+    let leaf = params.signed_by(&key, &ca, &ca_key).unwrap();
+    (ca, leaf, key)
+}
+
+fn configuration(ca: &Certificate) -> TlsConfiguration {
+    TlsConfiguration {
+        ca_certificates: CACertificates::EmbedderRootsOnly(vec![ca.der().clone()]),
+        ..Default::default()
+    }
+}
+
+fn verifier(ca: &Certificate) -> CertificateVerificationOverrideVerifier {
+    CertificateVerificationOverrideVerifier::try_new(
+        CACertificates::EmbedderRootsOnly(vec![ca.der().clone()]),
+        false,
+        CertificateErrorOverrideManager::new(),
+    )
+    .unwrap()
+}
