+#[test]
+fn preserves_explicit_trust_modes() {
+    assert!(matches!(
+        CACertificates::from_policy(RootTrustPolicy::EmbedderAndWebPki, vec![]),
+        CACertificates::CombineWithWebPki(_)
+    ));
+    assert!(matches!(
+        CACertificates::from_policy(RootTrustPolicy::EmbedderAndPlatform, vec![]),
+        CACertificates::CombineWithPlatform(_)
+    ));
+    assert!(matches!(
+        CACertificates::from_policy(RootTrustPolicy::EmbedderRootsOnly, vec![]),
+        CACertificates::EmbedderRootsOnly(_)
+    ));
+}
