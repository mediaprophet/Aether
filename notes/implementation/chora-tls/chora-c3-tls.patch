+#[test]
+fn prepared_profiles_have_independent_tls_resumption_stores() {
+    let (ca, leaf, key) = credentials(false);
+    let prepared = configuration(&ca).prepare().unwrap();
+    let public = prepared.create_config(CertificateErrorOverrideManager::new());
+    let private = prepared.create_config(CertificateErrorOverrideManager::new());
+    let server = server(&ca, &leaf, &key, false);
+    assert_ne!(
+        handshake_kind(public.clone(), server.clone()).unwrap(),
+        rustls::HandshakeKind::Resumed
+    );
+    // A private handshake must not consume or replace the public profile's tickets.
+    assert_ne!(
+        handshake_kind(private, server.clone()).unwrap(),
+        rustls::HandshakeKind::Resumed
+    );
+    assert_eq!(
+        handshake_kind(public, server).unwrap(),
+        rustls::HandshakeKind::Resumed
+    );
+}
