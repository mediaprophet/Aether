+#[test]
+fn rejects_invalid_roots_instead_of_silently_discarding_them() {
+    for bytes in [
+        b"".as_slice(),
+        b"not a certificate",
+        b"-----BEGIN CERTIFICATE-----\nnot-base64\n-----END CERTIFICATE-----",
+    ] {
+        assert!(parse_root_certificates(bytes).is_err());
+    }
+    let (ca, _, _) = credentials(false);
+    assert_eq!(
+        parse_root_certificates(ca.pem().as_bytes()).unwrap(),
+        vec![ca.der().clone()]
+    );
+    assert_eq!(
+        parse_root_certificates(ca.der().as_ref()).unwrap(),
+        vec![ca.der().clone()]
+    );
+    let mut broken = ca.pem().into_bytes();
+    broken.extend_from_slice(b"\n-----BEGIN CERTIFICATE-----\n@@@\n-----END CERTIFICATE-----\n");
+    assert!(parse_root_certificates(&broken).is_err());
+    let invalid = TlsConfiguration {
+        ca_certificates: CACertificates::EmbedderRootsOnly(vec![CertificateDer::from(vec![
+            0, 1, 2,
+        ])]),
+        ..Default::default()
+    };
+    assert!(
+        invalid
+            .create_config(CertificateErrorOverrideManager::new())
+            .is_err()
+    );
+    let empty = TlsConfiguration {
+        ca_certificates: CACertificates::EmbedderRootsOnly(vec![]),
+        ..Default::default()
+    };
+    assert!(
+        empty
+            .create_config(CertificateErrorOverrideManager::new())
+            .is_err()
+    );
+}
