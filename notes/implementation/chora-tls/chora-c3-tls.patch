+#[test]
+fn prepared_tls_configs_keep_profile_certificate_overrides_separate() {
+    let (ca, _, _) = credentials(false);
+    let prepared = configuration(&ca).prepare().unwrap();
+    let (untrusted_ca, untrusted_leaf, key) = credentials(false);
+    let public_overrides = CertificateErrorOverrideManager::new();
+    public_overrides.add_override(untrusted_leaf.der());
+    let public = prepared.create_config(public_overrides);
+    let private = prepared.create_config(CertificateErrorOverrideManager::new());
+    assert!(handshake(public, server(&untrusted_ca, &untrusted_leaf, &key, false)).is_ok());
+    assert!(handshake(private, server(&untrusted_ca, &untrusted_leaf, &key, false)).is_err());
+}
