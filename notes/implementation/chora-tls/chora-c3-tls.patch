+#[test]
+fn completes_tls_handshake_with_custom_ca_and_rejects_untrusted_chain() {
+    let (ca, leaf, key) = credentials(false);
+    let config = configuration(&ca)
+        .create_config(CertificateErrorOverrideManager::new())
+        .unwrap();
+    assert!(handshake(config, server(&ca, &leaf, &key, false)).is_ok());
+    let (unrelated_ca, _, _) = credentials(false);
+    let config = configuration(&unrelated_ca)
+        .create_config(CertificateErrorOverrideManager::new())
+        .unwrap();
+    assert!(handshake(config, server(&ca, &leaf, &key, false)).is_err());
+}
