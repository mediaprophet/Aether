+        RootTrustPolicy::EmbedderRootsOnly,
+        RootTrustPolicy::EmbedderAndWebPki,
+        RootTrustPolicy::EmbedderAndPlatform,
+    ];
+    for policy in policies {
+        let configuration = TlsConfiguration {
+            ca_certificates: CACertificates::from_policy(policy.clone(), vec![ca.der().clone()]),
