+    for deny in [false, true] {
+        let mut configuration = configuration(&ca);
+        configuration.embedder_verifier = Some(Arc::new(HostVerifier {
+            calls: calls.clone(),
+            deny,
+        }));
+        let config = configuration
+            .create_config(CertificateErrorOverrideManager::new())
+            .unwrap();
+        assert_eq!(
+            handshake(config, server(&ca, &leaf, &key, false)).is_err(),
