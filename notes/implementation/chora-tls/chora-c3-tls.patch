+/// Host-selected TLS settings used by both HTTP profiles and WebSocket connections.
+/// These callbacks grant no page authority; the host owns their trust decisions.
+#[derive(Clone, Debug, Default)]
+pub struct TlsConfiguration {
+    pub ca_certificates: CACertificates<'static>,
+    pub ignore_certificate_errors: bool,
+    pub client_cert_resolver: Option<Arc<dyn ResolvesClientCert>>,
+    pub embedder_verifier: Option<Arc<dyn EmbedderCertVerifier>>,
+}
+
+/// TLS provider/verifier state prepared before creating active resource threads.
+/// Client configs reuse this state; creating a connection does not reread root files
+/// or reconstruct a fallible platform verifier.
+#[derive(Clone, Debug)]
+pub struct PreparedTlsConfiguration {
+    template: TlsConfig,
+    main_verifier: Arc<dyn ServerCertVerifier>,
+    pub(crate) ca_certificates: CACertificates<'static>,
+    pub(crate) ignore_certificate_errors: bool,
+    embedder_verifier: Option<Arc<dyn EmbedderCertVerifier>>,
+}
+
+impl TlsConfiguration {
+    pub fn prepare(&self) -> Result<PreparedTlsConfiguration, TlsConfigurationError> {
+        let verifier = CertificateVerificationOverrideVerifier::try_new(
+            self.ca_certificates.clone(),
+            self.ignore_certificate_errors,
+            CertificateErrorOverrideManager::new(),
+        )?
+        .with_embedder_verifier(self.embedder_verifier.clone());
+        let main_verifier = verifier.main_verifier.clone();
+        let builder = rustls::ClientConfig::builder_with_provider(CRYPTO_PROVIDER_CACHE.clone())
+            .with_safe_default_protocol_versions()
+            .map_err(|error| TlsConfigurationError(error.to_string()))?
+            .dangerous()
+            .with_custom_certificate_verifier(Arc::new(verifier));
+        let template = match self.client_cert_resolver.clone() {
+            Some(resolver) => builder.with_client_cert_resolver(resolver),
+            None => builder.with_no_client_auth(),
+        };
+        Ok(PreparedTlsConfiguration {
+            template,
+            main_verifier,
+            ca_certificates: self.ca_certificates.clone(),
+            ignore_certificate_errors: self.ignore_certificate_errors,
+            embedder_verifier: self.embedder_verifier.clone(),
+        })
+    }
+
+    pub fn create_config(
+        &self,
+        manager: CertificateErrorOverrideManager,
+    ) -> Result<TlsConfig, TlsConfigurationError> {
+        Ok(self.prepare()?.create_config(manager))
+    }
+}
+
+impl PreparedTlsConfiguration {
+    pub fn create_config(&self, manager: CertificateErrorOverrideManager) -> TlsConfig {
+        let mut config = self.template.clone();
+        // ClientConfig cloning shares Arc-backed session state. Each caller/profile
+        // gets its own cache so private browsing cannot consume public TLS tickets.
+        config.resumption = rustls::client::Resumption::default();
+        config.dangerous().set_certificate_verifier(Arc::new(
+            CertificateVerificationOverrideVerifier {
+                main_verifier: self.main_verifier.clone(),
+                ignore_certificate_errors: self.ignore_certificate_errors,
+                override_manager: manager,
+                embedder_verifier: self.embedder_verifier.clone(),
+            },
+        ));
+        config
     }
 }
 
