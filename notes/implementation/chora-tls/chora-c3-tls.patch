+        mem_profiler_chan,
+        embedder_proxy,
+        config_dir,
+        configuration.ca_certificates.clone(),
+        configuration.ignore_certificate_errors,
+        protocols,
+        Some(configuration),
+    );
+    (
+        ResourceThreads::new(public),
+        ResourceThreads::new(private),
+        async_runtime,
+    )
+}
