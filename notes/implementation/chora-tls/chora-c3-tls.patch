+#[derive(Debug)]
+struct ClientCertificate(Arc<rustls::sign::CertifiedKey>);
+impl rustls::client::ResolvesClientCert for ClientCertificate {
+    fn resolve(
+        &self,
+        _hints: &[&[u8]],
+        _schemes: &[rustls::SignatureScheme],
+    ) -> Option<Arc<rustls::sign::CertifiedKey>> {
+        Some(self.0.clone())
+    }
+    fn has_certs(&self) -> bool {
+        true
+    }
+}
+
+fn server(
+    ca: &Certificate,
+    leaf: &Certificate,
+    key: &KeyPair,
+    mutual: bool,
+) -> rustls::ServerConfig {
+    let builder =
+        rustls::ServerConfig::builder_with_provider(net::connector::CRYPTO_PROVIDER_CACHE.clone())
+            .with_safe_default_protocol_versions()
+            .unwrap();
+    let builder = if mutual {
+        let mut roots = rustls::RootCertStore::empty();
+        roots.add(ca.der().clone()).unwrap();
+        builder.with_client_cert_verifier(
+            rustls::server::WebPkiClientVerifier::builder_with_provider(
+                roots.into(),
+                net::connector::CRYPTO_PROVIDER_CACHE.clone(),
+            )
+            .build()
+            .unwrap(),
+        )
+    } else {
+        builder.with_no_client_auth()
+    };
+    builder
+        .with_single_cert(
+            vec![leaf.der().clone()],
+            PrivatePkcs8KeyDer::from(key.serialize_der()).into(),
+        )
+        .unwrap()
+}
+
+fn handshake_kind(
+    client: rustls::ClientConfig,
+    server: rustls::ServerConfig,
+) -> Result<rustls::HandshakeKind, rustls::Error> {
+    let mut client =
+        rustls::ClientConnection::new(Arc::new(client), ServerName::try_from("localhost").unwrap())
+            .unwrap();
+    let mut server = rustls::ServerConnection::new(Arc::new(server)).unwrap();
+    for _ in 0..32 {
+        let mut bytes = Vec::new();
+        client.write_tls(&mut bytes).unwrap();
+        if !bytes.is_empty() {
+            server.read_tls(&mut Cursor::new(bytes)).unwrap();
+            server.process_new_packets()?;
+        }
+        let mut bytes = Vec::new();
+        server.write_tls(&mut bytes).unwrap();
+        if !bytes.is_empty() {
+            client.read_tls(&mut Cursor::new(bytes)).unwrap();
+            client.process_new_packets()?;
+        }
+        if !client.is_handshaking() && !server.is_handshaking() {
+            return client
+                .handshake_kind()
+                .ok_or_else(|| rustls::Error::General("Missing handshake kind".into()));
+        }
+    }
+    Err(rustls::Error::General("Handshake did not finish".into()))
+}
+
+fn handshake(
+    client: rustls::ClientConfig,
+    server: rustls::ServerConfig,
+) -> Result<(), rustls::Error> {
+    handshake_kind(client, server).map(|_| ())
+}
