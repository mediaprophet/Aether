+/// Invalid or unsupported TLS configuration, reported before network startup.
+#[derive(Debug)]
+pub struct TlsConfigurationError(pub String);
+
+impl std::fmt::Display for TlsConfigurationError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(&self.0)
+    }
+}
+impl std::error::Error for TlsConfigurationError {}
+impl From<std::io::Error> for TlsConfigurationError {
+    fn from(error: std::io::Error) -> Self {
+        Self(error.to_string())
+    }
+}
+
+/// Parse all certificates, rejecting empty or malformed bundles instead of dropping roots.
+pub fn parse_root_certificates(
+    bytes: &[u8],
+) -> Result<Vec<CertificateDer<'static>>, TlsConfigurationError> {
+    let certificates = if bytes.windows(11).any(|part| part == b"-----BEGIN ") {
+        CertificateDer::pem_slice_iter(bytes)
+            .map(|cert| cert.map_err(|error| TlsConfigurationError(error.to_string())))
+            .collect::<Result<Vec<_>, _>>()?
+    } else {
+        vec![CertificateDer::from(bytes.to_vec())]
+    };
+    if certificates.is_empty() {
+        return Err(TlsConfigurationError(
+            "Root certificate bundle is empty".into(),
+        ));
+    }
+    let mut roots = rustls::RootCertStore::empty();
+    for certificate in &certificates {
+        roots
+            .add(certificate.clone())
+            .map_err(|error| TlsConfigurationError(format!("Invalid root certificate: {error}")))?;
+    }
+    Ok(certificates
+        .into_iter()
+        .map(CertificateDer::into_owned)
+        .collect())
+}
